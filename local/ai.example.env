# The AI that runs on your PC (Ollama). Change the model here and restart Theme Pulse.
# qwen3.8:27b (about 18 GB) fits a 32 GB graphics card: strong reasoning, tools, can read chart images.
# Faster alternative: gemma4:26b (about 18 GB, only ~4B active, very quick). Off (cloud keys only): LOCAL_AI=off
LOCAL_LLM_MODEL=qwen3.8:27b
LOCAL_LLM_CTX=32768
